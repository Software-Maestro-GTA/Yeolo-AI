{
  "CourseRequestSchema": {
    "$defs": {
      "ActivityPreferenceSchema": {
        "properties": {
          "viewing": {
            "description": "관람형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Viewing",
            "type": "integer"
          },
          "experience": {
            "description": "체험형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Experience",
            "type": "integer"
          },
          "adventure": {
            "description": "모험형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Adventure",
            "type": "integer"
          },
          "photographyVideo": {
            "description": "사진·영상형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Photographyvideo",
            "type": "integer"
          },
          "gourmetExploration": {
            "description": "미식 탐방형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Gourmetexploration",
            "type": "integer"
          },
          "nightlife": {
            "description": "밤문화형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Nightlife",
            "type": "integer"
          },
          "shopping": {
            "description": "쇼핑형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Shopping",
            "type": "integer"
          },
          "relaxation": {
            "description": "휴식형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Relaxation",
            "type": "integer"
          },
          "localInteraction": {
            "description": "현지인 교류형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Localinteraction",
            "type": "integer"
          }
        },
        "required": [
          "viewing",
          "experience",
          "adventure",
          "photographyVideo",
          "gourmetExploration",
          "nightlife",
          "shopping",
          "relaxation",
          "localInteraction"
        ],
        "title": "ActivityPreferenceSchema",
        "type": "object"
      },
      "FoodPreferenceSchema": {
        "properties": {
          "localFoodActive": {
            "description": "현지 음식 적극 체험형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Localfoodactive",
            "type": "integer"
          },
          "famousRestaurantCentered": {
            "description": "유명 맛집 중심형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Famousrestaurantcentered",
            "type": "integer"
          },
          "streetFood": {
            "description": "길거리 음식형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Streetfood",
            "type": "integer"
          },
          "cafeDessert": {
            "description": "카페·디저트형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Cafedessert",
            "type": "integer"
          },
          "fineDining": {
            "description": "파인다이닝형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Finedining",
            "type": "integer"
          },
          "familiarFoodPreferred": {
            "description": "익숙한 음식 선호형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Familiarfoodpreferred",
            "type": "integer"
          },
          "dietaryRestriction": {
            "description": "식단 제한형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Dietaryrestriction",
            "type": "integer"
          },
          "sightseeingOverFood": {
            "description": "음식보다 관광 중시형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Sightseeingoverfood",
            "type": "integer"
          }
        },
        "required": [
          "localFoodActive",
          "famousRestaurantCentered",
          "streetFood",
          "cafeDessert",
          "fineDining",
          "familiarFoodPreferred",
          "dietaryRestriction",
          "sightseeingOverFood"
        ],
        "title": "FoodPreferenceSchema",
        "type": "object"
      },
      "PreferredLocationTypeSchema": {
        "properties": {
          "bigCity": {
            "description": "대도시형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Bigcity",
            "type": "integer"
          },
          "smallTownAlley": {
            "description": "소도시·골목형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Smalltownalley",
            "type": "integer"
          },
          "natureHinterland": {
            "description": "자연·오지형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Naturehinterland",
            "type": "integer"
          },
          "beachResort": {
            "description": "해변·휴양지형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Beachresort",
            "type": "integer"
          },
          "mountainPlateau": {
            "description": "산악·고원형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Mountainplateau",
            "type": "integer"
          },
          "historicalCity": {
            "description": "역사도시형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Historicalcity",
            "type": "integer"
          },
          "themeParkResort": {
            "description": "테마파크·리조트형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Themeparkresort",
            "type": "integer"
          },
          "famousSpotPreferred": {
            "description": "유명 관광지 선호형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Famousspotpreferred",
            "type": "integer"
          },
          "hiddenSpotPreferred": {
            "description": "숨은 명소 선호형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Hiddenspotpreferred",
            "type": "integer"
          }
        },
        "required": [
          "bigCity",
          "smallTownAlley",
          "natureHinterland",
          "beachResort",
          "mountainPlateau",
          "historicalCity",
          "themeParkResort",
          "famousSpotPreferred",
          "hiddenSpotPreferred"
        ],
        "title": "PreferredLocationTypeSchema",
        "type": "object"
      },
      "TasteProfileSchema": {
        "properties": {
          "travelPurpose": {
            "$ref": "#/$defs/TravelPurposeSchema",
            "description": "여행 목적 선호도"
          },
          "travelPaceDensity": {
            "description": "여행 속도/일정 밀도",
            "enum": [
              "slow_stay",
              "balanced",
              "dense_schedule",
              "spontaneous",
              "long_stay"
            ],
            "title": "Travelpacedensity",
            "type": "string"
          },
          "preferredLocationType": {
            "$ref": "#/$defs/PreferredLocationTypeSchema",
            "description": "선호 장소 유형"
          },
          "activityPreference": {
            "$ref": "#/$defs/ActivityPreferenceSchema",
            "description": "활동 취향"
          },
          "spendingTendency": {
            "description": "소비 성향",
            "enum": [
              "cost_effective",
              "moderate",
              "luxury"
            ],
            "title": "Spendingtendency",
            "type": "string"
          },
          "companionType": {
            "description": "동행 형태",
            "enum": [
              "solo",
              "couple",
              "friends",
              "family",
              "with_children",
              "with_parents",
              "group",
              "with_pet",
              "social"
            ],
            "title": "Companiontype",
            "type": "string"
          },
          "foodPreference": {
            "$ref": "#/$defs/FoodPreferenceSchema",
            "description": "음식 취향"
          },
          "seasonalEnvironmentPreference": {
            "description": "계절/환경 취향",
            "items": {
              "enum": [
                "warm_region",
                "cold_region",
                "summer_resort",
                "winter_sports",
                "spring_flower_autumn_foliage",
                "dry_weather",
                "off_season",
                "peak_season"
              ],
              "type": "string"
            },
            "title": "Seasonalenvironmentpreference",
            "type": "array"
          }
        },
        "required": [
          "travelPurpose",
          "travelPaceDensity",
          "preferredLocationType",
          "activityPreference",
          "spendingTendency",
          "companionType",
          "foodPreference"
        ],
        "title": "TasteProfileSchema",
        "type": "object"
      },
      "TravelPurposeSchema": {
        "properties": {
          "relaxation": {
            "description": "휴양형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Relaxation",
            "type": "integer"
          },
          "sightseeing": {
            "description": "관광형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Sightseeing",
            "type": "integer"
          },
          "culturalExperience": {
            "description": "문화체험형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Culturalexperience",
            "type": "integer"
          },
          "gourmet": {
            "description": "미식형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Gourmet",
            "type": "integer"
          },
          "natureExploration": {
            "description": "자연탐방형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Natureexploration",
            "type": "integer"
          },
          "activity": {
            "description": "액티비티형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Activity",
            "type": "integer"
          },
          "shopping": {
            "description": "쇼핑형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Shopping",
            "type": "integer"
          },
          "festivalEvent": {
            "description": "축제·이벤트형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Festivalevent",
            "type": "integer"
          },
          "wellness": {
            "description": "웰니스형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Wellness",
            "type": "integer"
          },
          "selfDevelopment": {
            "description": "자기계발형 (1-5)",
            "maximum": 5,
            "minimum": 1,
            "title": "Selfdevelopment",
            "type": "integer"
          }
        },
        "required": [
          "relaxation",
          "sightseeing",
          "culturalExperience",
          "gourmet",
          "natureExploration",
          "activity",
          "shopping",
          "festivalEvent",
          "wellness",
          "selfDevelopment"
        ],
        "title": "TravelPurposeSchema",
        "type": "object"
      },
      "TripConditionSchema": {
        "properties": {
          "destinationCountry": {
            "description": "목적지 국가",
            "minLength": 1,
            "title": "Destinationcountry",
            "type": "string"
          },
          "destinationCity": {
            "description": "목적지 도시",
            "minLength": 1,
            "title": "Destinationcity",
            "type": "string"
          },
          "startDate": {
            "description": "시작일 (YYYY-MM-DD)",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "title": "Startdate",
            "type": "string"
          },
          "totalDays": {
            "description": "총 여행 일수",
            "minimum": 1,
            "title": "Totaldays",
            "type": "integer"
          },
          "budget": {
            "description": "전체 여행 예상 예산 금액 (KRW), 초과해도 생성 허용",
            "minimum": 0,
            "title": "Budget",
            "type": "number"
          }
        },
        "required": [
          "destinationCountry",
          "destinationCity",
          "startDate",
          "totalDays",
          "budget"
        ],
        "title": "TripConditionSchema",
        "type": "object"
      }
    },
    "properties": {
      "userId": {
        "description": "사용자 ID (UUID)",
        "format": "uuid",
        "title": "Userid",
        "type": "string"
      },
      "language": {
        "description": "응답 문구의 BCP 47 언어 코드 (예: ko, en, ja, zh-TW)",
        "title": "Language",
        "type": "string"
      },
      "mbti": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "사용자 MBTI",
        "title": "Mbti"
      },
      "tasteProfile": {
        "anyOf": [
          {
            "$ref": "#/$defs/TasteProfileSchema"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "성향 프로필 데이터"
      },
      "tripCondition": {
        "$ref": "#/$defs/TripConditionSchema",
        "description": "여행 제약 조건"
      }
    },
    "required": [
      "userId",
      "language",
      "tripCondition"
    ],
    "title": "CourseRequestSchema",
    "type": "object"
  },
  "CourseResponseSchema": {
    "$defs": {
      "CourseSchema": {
        "properties": {
          "title": {
            "description": "요청 언어로 작성된 코스 제목",
            "title": "Title",
            "type": "string"
          },
          "destinationCountry": {
            "description": "목적지 국가",
            "title": "Destinationcountry",
            "type": "string"
          },
          "destinationCity": {
            "description": "목적지 도시",
            "title": "Destinationcity",
            "type": "string"
          },
          "startDate": {
            "description": "시작일",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "title": "Startdate",
            "type": "string"
          },
          "totalDays": {
            "description": "총 여행 일수",
            "minimum": 1,
            "title": "Totaldays",
            "type": "integer"
          },
          "totalCost": {
            "default": 0,
            "description": "일정 비용과 왕복 교통·숙박 실조회 또는 기준 추정액의 합계 (KRW); 공항·숙소 stop 비용은 중복 합산하지 않음",
            "minimum": 0,
            "title": "Totalcost",
            "type": "integer"
          },
          "tags": {
            "description": "요청 언어로 작성된 여행 태그",
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "itinerary": {
            "$ref": "#/$defs/ItinerarySchema",
            "description": "확정된 세부 여정"
          }
        },
        "required": [
          "title",
          "destinationCountry",
          "destinationCity",
          "startDate",
          "totalDays",
          "itinerary"
        ],
        "title": "CourseSchema",
        "type": "object"
      },
      "DayItinerarySchema": {
        "properties": {
          "day": {
            "description": "일차",
            "minimum": 1,
            "title": "Day",
            "type": "integer"
          },
          "date": {
            "description": "날짜",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "title": "Date",
            "type": "string"
          },
          "stops": {
            "description": "일자별 방문 장소",
            "items": {
              "$ref": "#/$defs/StopSchema"
            },
            "title": "Stops",
            "type": "array"
          }
        },
        "required": [
          "day",
          "date",
          "stops"
        ],
        "title": "DayItinerarySchema",
        "type": "object"
      },
      "ItinerarySchema": {
        "properties": {
          "days": {
            "description": "일자별 여정",
            "items": {
              "$ref": "#/$defs/DayItinerarySchema"
            },
            "title": "Days",
            "type": "array"
          }
        },
        "required": [
          "days"
        ],
        "title": "ItinerarySchema",
        "type": "object"
      },
      "PlaceSchema": {
        "description": "Verified identity and map marker only; rich details stay in Google Maps.",
        "properties": {
          "placeId": {
            "description": "검증된 Google Maps Place ID",
            "title": "Placeid",
            "type": "string"
          },
          "placeName": {
            "description": "요청 언어로 표기한 검증 장소명; Google 공식 표시 이름은 조회하지 않음",
            "title": "Placename",
            "type": "string"
          },
          "category": {
            "description": "앱 장소 분류: FOOD(맛집·미식), CAFE(카페·디저트), SPOT(스팟·명소), CULTURE(문화·전시), NATURE(자연·산책), ACTIVITY(액티비티·체험), NIGHTLIFE(야경·나이트), LODGING(숙소), AIRPORT(공항)",
            "enum": [
              "FOOD",
              "CAFE",
              "SPOT",
              "CULTURE",
              "NATURE",
              "ACTIVITY",
              "NIGHTLIFE",
              "LODGING",
              "AIRPORT"
            ],
            "title": "Category",
            "type": "string"
          },
          "latitude": {
            "description": "위도",
            "title": "Latitude",
            "type": "number"
          },
          "longitude": {
            "description": "경도",
            "title": "Longitude",
            "type": "number"
          }
        },
        "required": [
          "placeId",
          "placeName",
          "category",
          "latitude",
          "longitude"
        ],
        "title": "PlaceSchema",
        "type": "object"
      },
      "StopSchema": {
        "properties": {
          "sequence": {
            "description": "방문 순서",
            "minimum": 1,
            "title": "Sequence",
            "type": "integer"
          },
          "stayMinutes": {
            "description": "체류 시간 (분)",
            "minimum": 1,
            "title": "Stayminutes",
            "type": "integer"
          },
          "memo": {
            "description": "검증을 통과한 LLM 방문 팁; 생성·검증 미확보 시 빈 문자열",
            "title": "Memo",
            "type": "string"
          },
          "reason": {
            "description": "취향과 검증된 장소에 근거한 LLM 추천 이유; 생성·검증 미확보 시 빈 문자열",
            "title": "Reason",
            "type": "string"
          },
          "cost": {
            "default": 0,
            "description": "예상 활동·식사·입장 비용 또는 해당 일차 숙박 비용 (KRW); 첫날·마지막 날 공항은 왕복 항공료를 나눈 편도 예상 배분액이며 실제 편도 견적은 아님. 항공·숙박 비용은 totalCost에 중복 합산하지 않음",
            "minimum": 0,
            "title": "Cost",
            "type": "integer"
          },
          "place": {
            "$ref": "#/$defs/PlaceSchema",
            "description": "지도 연결용 장소 정보"
          },
          "transportToNext": {
            "$ref": "#/$defs/TransportToNextSchema",
            "description": "다음 장소까지 실제 이동 정보"
          }
        },
        "required": [
          "sequence",
          "stayMinutes",
          "memo",
          "reason",
          "place",
          "transportToNext"
        ],
        "title": "StopSchema",
        "type": "object"
      },
      "TransportToNextSchema": {
        "properties": {
          "type": {
            "description": "다음 장소까지 이동 수단; unknown은 조회 미확보, none은 다음 이동 없음",
            "enum": [
              "walking",
              "transit",
              "driving",
              "taxi",
              "unknown",
              "none"
            ],
            "title": "Type",
            "type": "string"
          },
          "distance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "실제 이동 거리 (미터)",
            "title": "Distance"
          },
          "minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "실제 이동 소요 시간 (분)",
            "title": "Minutes"
          },
          "memo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "실제 경로 정보에 근거한 이동 안내; 작성 가능한 정보가 없으면 null",
            "title": "Memo"
          }
        },
        "required": [
          "type"
        ],
        "title": "TransportToNextSchema",
        "type": "object"
      }
    },
    "properties": {
      "course": {
        "$ref": "#/$defs/CourseSchema",
        "description": "생성된 여행 코스"
      }
    },
    "required": [
      "course"
    ],
    "title": "CourseResponseSchema",
    "type": "object"
  },
  "ProgressEventData": {
    "properties": {
      "step": {
        "const": "GENERATING_ROUTE",
        "default": "GENERATING_ROUTE",
        "title": "Step",
        "type": "string"
