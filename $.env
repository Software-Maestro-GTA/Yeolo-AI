# 백엔드 내부 통신 인증 API Key
INTERNAL_API_KEY=<your-internal-api-key>

# Gemini API Key & Model Name
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL_NAME=gemini-3.8-flash

# ABTO Calling: server-only secret. Configure Gemini routing for both features.
ABTO_CALLING_KEY=<your-abto-calling-key>
ABTO_GATEWAY_BASE_URL=https://gateway.abto.app/v1
TASTE_ANALYSIS_TIMEOUT_SECONDS=60

# Google Map API (Place & Route)
GOOGLE_MAPS_API_KEY=<your-google-map-api-key>

# LangSmith Tracing Settings
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_PROJECT="YEOLO"

# 로그 레벨 (DEV: DEBUG, PROD: INFO)
LOG_LEVEL=INFO
